"""Vista previa de Xhendra para Family Calendar. Solo lectura.
Instalar: python -m pip install caldav
Ejecutar: python vista_previa_enanos.py
No guarda credenciales ni crea eventos. No envia mensajes a Telegram.
"""
import getpass
import html
import imaplib
import logging
import re
import ssl
import sys
import unicodedata
from datetime import date
from email import policy
from email.parser import BytesParser
from html.parser import HTMLParser

import caldav

CALENDARIO = 'Family Calendar'
REMITENTE = 'sistema@xhendra.com.ar'
logging.disable(logging.CRITICAL)
MESES = {nombre: i for i, nombre in enumerate(
    ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio',
     'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'], 1)}
DIAS = ['lunes', 'martes', 'miercoles', 'jueves', 'viernes', 'sabado', 'domingo']
# Reconoce fechas numericas y escritas, pero no pretende interpretar lenguaje libre.
FECHA = re.compile(
    r'(?<![\d/])(\d{1,2})(?:\s+y\s+(\d{1,2}))?/'
    r'(\d{1,2})(?:/(\d{4}))?(?![\d/])|'
    r'(?<!\d)(\d{1,2})\s+de\s+(' + '|'.join(MESES) + r')\b', re.I)
HORA = re.compile(r'\b(?:[01]?\d|2[0-3]):[0-5]\d\b|\b(?:[01]?\d|2[0-3])\s*(?:hs|horas)\b', re.I)


def normalizar(texto):
    return ''.join(c for c in unicodedata.normalize('NFD', texto.lower())
                   if unicodedata.category(c) != 'Mn')


class TextoHTML(HTMLParser):
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.partes = []
        self.oculto = 0

    def handle_starttag(self, tag, attrs):
        if tag in ('style', 'script'):
            self.oculto += 1
        if tag in ('p', 'div', 'br', 'li', 'tr') and not self.oculto:
            self.partes.append('\n')

    def handle_endtag(self, tag):
        if tag in ('style', 'script'):
            self.oculto = max(0, self.oculto - 1)
        if tag in ('p', 'div', 'li', 'tr') and not self.oculto:
            self.partes.append('\n')

    def handle_data(self, data):
        if not self.oculto:
            self.partes.append(data)


def texto_mensaje(mensaje):
    cuerpo = mensaje.get_body(preferencelist=('plain', 'html'))
    if cuerpo is None:
        raise ValueError('El correo no tiene cuerpo de texto disponible')
    texto = cuerpo.get_content()
    if cuerpo.get_content_type() == 'text/html':
        parser = TextoHTML()
        parser.feed(texto)
        texto = ''.join(parser.partes)
    return ocultar_enlaces(html.unescape(texto)).replace('\xa0', ' ')


def leer_correo(usuario, clave):
    with imaplib.IMAP4_SSL('imap.mail.me.com', 993,
                          ssl_context=ssl.create_default_context(), timeout=30) as conexion:
        conexion.login(usuario, clave)
        estado, _ = conexion.select('INBOX', readonly=True)
        if estado != 'OK':
            raise RuntimeError('No se pudo abrir INBOX')
        estado, datos = conexion.uid('search', None, 'TEXT', '"' + REMITENTE + '"')
        if estado != 'OK':
            raise RuntimeError('Fallo la busqueda')
        ids = datos[0].split()[-5:]
        if not ids:
            raise ValueError('No hay candidatos de Xhendra en INBOX')
        mensajes = []
        for uid in reversed(ids):
            estado, partes = conexion.uid('fetch', uid, '(BODY.PEEK[])')
            if estado != 'OK':
                raise RuntimeError('Fallo la lectura')
            raw = next(p[1] for p in partes if isinstance(p, tuple))
            mensajes.append(BytesParser(policy=policy.default).parsebytes(raw))
        print('\nUltimos candidatos (el remitente citado no verifica autenticidad):')
        for numero, mensaje in enumerate(mensajes, 1):
            print(f'{numero}. {mensaje.get("Subject", "Sin asunto")}')
        seleccion = int(input('Numero de correo para revisar [1]: ').strip() or '1')
        if not 1 <= seleccion <= len(mensajes):
            raise ValueError('Seleccion fuera de rango')
        return texto_mensaje(mensajes[seleccion - 1])


def verificar_calendario(usuario, clave):
    cliente = caldav.DAVClient(url='https://caldav.icloud.com/',
                              username=usuario, password=clave, timeout=30)
    try:
        encontrados = [c for c in cliente.principal().calendars()
                       if c.get_display_name() == CALENDARIO]
        if len(encontrados) != 1:
            raise ValueError('Debe existir exactamente un calendario Family Calendar')
        print('\nDestino encontrado: Family Calendar (solo consulta).')
        print('La lectura no comprueba todavia el permiso de escritura.')
    finally:
        cliente.close()


def ocultar_enlaces(texto):
    # No imprimir URLs: algunos enlaces del correo autentican al usuario.
    texto = re.sub(r'https?://[^\s<>]+', '[enlace omitido]', texto, flags=re.I)
    return re.sub(r'(?i)\bloginToken\s*=\s*[^\s<>]+', 'loginToken=[omitido]', texto)


def limpiar_lineas(texto):
    """Quita cabeceras de reenvio y el pie de Xhendra antes de buscar fechas."""
    salida = []
    for linea in html.unescape(texto).splitlines():
        linea = linea.strip().lstrip('>').strip()
        plano = normalizar(linea)
        if re.match(r'^(notificarme|ver en xhendra|no responda a este mail|\[google play\])', plano):
            break
        if re.match(r'^(de|from|enviado|sent|fecha|date|para|to|cc|asunto|subject)\s*:', plano):
            continue
        if re.match(r'^(\[logo|[-_]{3,}|begin forwarded message|inicio del mensaje reenviado)', plano):
            continue
        linea = ocultar_enlaces(linea)
        if linea:
            salida.append(linea)
    return salida


def dividir_acto_retiro(bloque):
    """Regla conservadora: divide solo si cada actividad tiene una hora unica.

    No resuelve todos los textos posibles. Los casos no reconocidos conservan
    todas sus horas y quedan para revision, sin elegir una arbitrariamente.
    """
    texto = bloque['texto']
    plano = normalizar(texto)
    if not (re.search(r'\bacto\b', plano) and re.search(r'retir|salida', plano)):
        return [bloque]
    oraciones = re.split(r'(?<=[.!?;])\s+', texto.lstrip('. '))
    retiro = [s for s in oraciones if re.search(r'retir|salida', normalizar(s))]
    acto = [s for s in oraciones if re.search(r'\bacto\b|regresan', normalizar(s))
            and not re.search(r'retir|salida', normalizar(s))]
    horas_retiro = list(dict.fromkeys(HORA.findall(' '.join(retiro))))
    horas_acto = list(dict.fromkeys(HORA.findall(' '.join(acto))))
    if len(horas_retiro) != 1 or len(horas_acto) != 1:
        return [bloque]
    separados = []
    for titulo, partes in [('Retiro de alumnos', retiro), ('Acto escolar', acto)]:
        copia = dict(bloque)
        copia['texto'] = ' '.join(partes)
        copia['titulo'] = titulo
        copia['separado'] = True
        separados.append(copia)
    return separados


def candidatos(texto, anio):
    bloques = []
    actual = None
    contexto = ''
    anio_seccion = anio
    for linea in limpiar_lineas(texto):
        plano = normalizar(linea)
        # Un encabezado nuevo termina el evento anterior, no se agrega a el.
        proximo = 'ano proximo' in plano or 'proximo ano' in plano
        encabezado = bool(re.match(r'^[*\-\u2022. ]*(?:primera\s+)?reunion de familias', plano)
                          or re.match(r'^[*\-\u2022. ]*inicio de clases', plano))
        tiene_fecha = FECHA.search(plano)
        if proximo or (encabezado and not tiene_fecha):
            if actual:
                bloques.append(actual)
                actual = None
            contexto = linea
            explicitos = re.findall(r'\b20\d{2}\b', plano)
            if explicitos:
                anio_seccion = int(explicitos[-1])
            elif proximo:
                anio_seccion = anio + 1
            continue
        if tiene_fecha:
            if actual:
                bloques.append(actual)
            # Una actividad distinta con su fecha no hereda "reunion".
            contexto_evento = linea if encabezado else contexto
            actual = {'linea': linea, 'texto': linea, 'contexto': contexto_evento,
                      'anio_seccion': anio_seccion}
        elif actual:
            # Evita incorporar despedidas generales al ultimo evento.
            if plano.startswith('que estos ultimos'):
                bloques.append(actual)
                actual = None
            else:
                actual['texto'] += '\n' + linea
    if actual:
        bloques.append(actual)
    bloques = [parte for bloque in bloques for parte in dividir_acto_retiro(bloque)]
    resultados = []
    for bloque in bloques:
        linea = normalizar(bloque['linea'])
        anios = re.findall(r'\b20\d{2}\b', linea)
        elegido = int(anios[-1]) if anios else bloque['anio_seccion']
        avisos = ['PENDIENTE: revisar antes de cargar en Family Calendar.']
        if bloque.get('separado'):
            avisos.append('Actividad separada por su oracion y horario; validar el alcance.')
        if not anios:
            avisos.append(f'Ano {elegido} inferido del ano base o de la seccion del comunicado.')
        fechas = []
        for match in FECHA.finditer(linea):
            if match.group(5):
                dias, mes, ano = [int(match.group(5))], MESES[match.group(6).lower()], elegido
            else:
                dias = [int(match.group(1))]
                if match.group(2):
                    dias.append(int(match.group(2)))
                mes, ano = int(match.group(3)), int(match.group(4) or elegido)
            for dia in dias:
                try:
                    fecha = date(ano, mes, dia)
                    fechas.append(fecha.isoformat())
                    escritos = [d for d in DIAS if re.search(r'\b' + d + r'\b', linea)]
                    if escritos and DIAS[fecha.weekday()] not in escritos:
                        avisos.append(f'CONTRADICCION: {fecha:%d/%m/%Y} es {DIAS[fecha.weekday()]}.')
                except ValueError:
                    avisos.append(f'FECHA INVALIDA: {dia}/{mes}/{ano}')
        horas = list(dict.fromkeys(HORA.findall(bloque['texto'])))
        if len(horas) > 1:
            avisos.append('VARIAS HORAS SIN RESOLVER: no se elige una automaticamente.')
        if not horas:
            avisos.append('Sin hora informada: posible evento de todo el dia, pendiente de validar.')
        plano = normalizar(bloque['texto'])
        if 'todas las salas' in plano:
            avisos.append('Alcance indicado: todas las salas.')
        elif re.search(r'\bsalas?\b|\bgrados?\b', plano):
            avisos.append('SELECCION PENDIENTE: evento especifico de sala/grado.')
        resultados.append((bloque, fechas, horas, avisos))
    return resultados


def autoprueba():
    """Regresion local sin credenciales, Internet ni modificaciones a iCloud."""
    muestra = '''Enviado: viernes, 20 de noviembre de 2026 12:40
Asunto: FECHAS IMPORTANTES
. 7 y 8/12 JUEVES Feriado.
. 9/12 MIERCOLES 19:00 hs Acto escolar para salas de 5 anos 2026. Como todo el nivel participa, retirandose todas las salas luego del almuerzo 13:15 hs. Los ninos de salas de 5 regresan a las 19:00 hs.
. 18/12 VIERNES Envio de informes.
Anticipandonos para el ano proximo:
* Primera Reunion de Familias, sin alumnos/as
SALAS de 2 y 3 ANOS 2027 Miercoles 24/2 8:30 hs.
SALAS de 4 y 5 ANOS 2027 Jueves 25/2 8:30 hs.
* Inicio de clases Ciclo 2027 1 de Marzo
Que estos ultimos pasitos del ano nos encuentren unidos.
Notificarme<https://example.invalid/?loginToken=SECRETO_DE_PRUEBA>
Pie de correo 20/11/2026'''
    resultados = candidatos(muestra, 2026)
    assert len(resultados) == 7, 'Cantidad de candidatos inesperada'
    assert not any('2026-11-20' in r[1] for r in resultados), 'Cabecera tratada como evento'
    assert any('CONTRADICCION' in a for a in resultados[0][3]), 'No detecta dia contradictorio'
    retiro = next(r for r in resultados if r[0].get('titulo') == 'Retiro de alumnos')
    acto = next(r for r in resultados if r[0].get('titulo') == 'Acto escolar')
    assert retiro[2] == ['13:15'] and acto[2] == ['19:00'], 'Horarios mal separados'
    assert 'todas las salas' in retiro[0]['texto'], 'Se perdio alcance del retiro'
    informes = next(r for r in resultados if r[1] == ['2026-12-18'])
    assert 'proximo' not in informes[0]['texto'], 'Encabezado pegado al evento anterior'
    inicio = next(r for r in resultados if r[1] == ['2027-03-01'])
    assert 'Inicio de clases' in inicio[0]['contexto'], 'Contexto heredado incorrectamente'
    assert 'SECRETO_DE_PRUEBA' not in repr(resultados), 'Se filtro un token'
    assert 'SECRETO' not in ocultar_enlaces('https://example.invalid/?loginToken=SECRETO')
    assert candidatos('Anticipandonos para el ano proximo:\n1/3 Inicio', 2026)[0][1] == ['2027-03-01']
    assert any('FECHA INVALIDA' in a for a in candidatos('31/2 Reunion', 2026)[0][3])
    parser = TextoHTML()
    parser.feed('<p>9/12 Salida 13:15</p><script>dato oculto</script>')
    assert 'dato oculto' not in ''.join(parser.partes)
    print('OK: autoprueba de cabeceras, contexto, anos, horas, HTML y enlaces.')


def main():
    print('VISTA PREVIA PARA FAMILY CALENDAR. No crea eventos ni envia avisos.\n')
    mail = input('Correo iCloud: ').strip()
    apple = input('Cuenta Apple [Enter si coincide]: ').strip() or mail
    clave = getpass.getpass('Contrasena especifica para apps: ').strip()
    if not mail or not clave:
        raise ValueError('Faltan credenciales')
    verificar_calendario(apple, clave)
    texto = leer_correo(mail, clave)
    # El reenvio puede tener fecha distinta a la publicacion. No usamos ese ano a ciegas.
    anio = int(input('Ano base del comunicado original (ejemplo: 2026): ').strip())
    if not 2000 <= anio <= 2100:
        raise ValueError('Ano fuera de rango')
    resultados = candidatos(texto, anio)
    print(f'\nCandidatos para revision: {len(resultados)}')
    for numero, (bloque, fechas, horas, avisos) in enumerate(resultados, 1):
        print(f'\n[{numero}] Fechas: {", ".join(fechas) or "Revisar"}')
        print('Actividad:', bloque.get('titulo', 'Revisar texto'))
        print('Horas encontradas:', ', '.join(horas) or 'Ninguna')
        print('Contexto:', bloque['contexto'] or '(sin encabezado)')
        print('Texto original:\n' + bloque['texto'])
        for aviso in avisos:
            print('  - ' + aviso)
    print('\nFIN: no se escribio en iCloud ni se envio nada a Telegram.')
    print('Deteccion preliminar: las fechas relativas y otros formatos requieren revision.')


if __name__ == '__main__':
    try:
        if '--autoprueba' in sys.argv:
            autoprueba()
        else:
            main()
    except (KeyboardInterrupt, EOFError):
        print('\nCancelado.')
    except Exception as error:
        if '--autoprueba' in sys.argv:
            raise
        # No se imprimen respuestas de servidores que puedan contener datos privados.
        print(f'No se pudo completar la prueba: {type(error).__name__}.')
        print('Revisa credenciales, seleccion de correo, ano y conexion.')


